# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic ──────────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude. Default: claude-sonnet-5
#   claude-opus-5     el mas capaz             $5 / $25 por millon de tokens
#   claude-sonnet-5   el balanceado (default)  $3 / $15
#   claude-haiku-4-5  el mas barato y rapido   $1 / $5
ANTHROPIC_MODEL=claude-sonnet-5

# Esfuerzo de razonamiento: low | medium | high
# Dejalo vacio para no enviar el parametro (los modelos viejos no lo aceptan).
ANTHROPIC_EFFORT=low

# Opcional. Tope de tokens por respuesta, default 4096. Ojo: en los modelos
# actuales el razonamiento interno tambien cuenta contra este tope.
# ANTHROPIC_MAX_TOKENS=4096

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: zernio | meta
WHATSAPP_PROVIDER=

# ── Zernio (si WHATSAPP_PROVIDER=zernio) ───────────────────
# Crear cuenta y conectar WhatsApp en: https://zernio.com
# La API key se genera en Settings -> API Keys (empieza con "sk_")
ZERNIO_API_KEY=
# El webhook secret lo inventas tu. Sirve para verificar que los
# mensajes vienen de Zernio y no de cualquiera que sepa tu URL.
ZERNIO_WEBHOOK_SECRET=
# Opcional: solo se usa para chequear la conexion al arrancar.
# Para responder, el account id sale del propio webhook.
ZERNIO_ACCOUNT_ID=
# Opcional: solo si necesitas apuntar a otra URL. Dejala comentada para usar
# la de siempre, https://zernio.com/api/v1
# ZERNIO_BASE_URL=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ─────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
# Limites para proteger el webhook de abuso. Ajustalos al volumen esperado.
MAX_WEBHOOK_BODY_BYTES=262144
MAX_WEBHOOKS_PER_MINUTE=60
MAX_MENSAJES_POR_WEBHOOK=10
MAX_PROCESAMIENTOS_CONCURRENTES=20

# ── Base de datos ──────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Dias maximos para conservar conversaciones, leads y citas. Define un valor acorde
# a tu aviso de privacidad y obligaciones legales.
DATA_RETENTION_DAYS=90

# ── Sistema Académico USPG (crear inscripciones) ────────────
# URL base del backend de uspg-sistema-academico (sin barra final).
ACADEMIC_SYSTEM_URL=
# Debe ser EXACTAMENTE el mismo valor que WHATSAPP_AGENT_API_KEY en el .env
# de uspg-sistema-academico. Generar con: openssl rand -hex 32
ACADEMIC_SYSTEM_API_KEY=
